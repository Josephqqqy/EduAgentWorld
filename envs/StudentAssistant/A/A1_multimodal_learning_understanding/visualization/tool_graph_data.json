{
  "title": "A1 多模态学习理解环境工具依赖图",
  "nodes": [
    {
      "id": "upload_artifact",
      "label": "上传学习材料",
      "description": "上传学生提供的图片或 PDF 等学习素材"
    },
    {
      "id": "get_artifact",
      "label": "查询学习材料",
      "description": "查询已上传学习材料的基本信息"
    },
    {
      "id": "list_artifact_regions",
      "label": "列出题目区域",
      "description": "识别一张图片中包含的题目区域"
    },
    {
      "id": "recognize_content",
      "label": "识别题目内容",
      "description": "识别题目文字、数学表达式和结构化内容"
    },
    {
      "id": "extract_editable_text",
      "label": "导出可编辑文本",
      "description": "将题目整理为 Markdown 和 LaTeX 等可编辑文本"
    },
    {
      "id": "assess_content_completeness",
      "label": "判断题目完整性",
      "description": "判断题目内容是否完整，并指出可能缺失的部分"
    },
    {
      "id": "get_problem_context",
      "label": "获取单题上下文",
      "description": "获取某道题的规范化题目、元数据和解题上下文"
    },
    {
      "id": "get_artifact_problem_contexts",
      "label": "获取图片全部题目",
      "description": "按题目区域顺序获取一张图片中的全部题目上下文"
    },
    {
      "id": "analyze_diagram",
      "label": "分析数学图形",
      "description": "分析题目中的数学图形及其已知关系"
    },
    {
      "id": "analyze_problem_knowledge",
      "label": "分析知识点",
      "description": "分析题目涉及的主题和解法关联知识点"
    },
    {
      "id": "submit_solution",
      "label": "提交题目解答",
      "description": "提交某道题的最终答案和推理过程"
    }
  ],
